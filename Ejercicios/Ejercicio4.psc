Algoritmo Ejercicio4
	Definir numero1,numero2,suma,resta,multiplicacion,division Como Real;
	Escribir "Ingrese un primer valor";
	Leer numero1;
	Escribir "Ingrese un segundo valor";
	Leer numero2;
	suma=numero1+numero2;
	resta=numero1-numero2;
	multiplicacion= numero1*numero2;
	division=numero1/numero2;
	Escribir "-------EL resultado de las operaciones :-------";
	Escribir "| ",numero1,"+",numero2,"=",suma;
	Escribir "| ",numero1,"-",numero2,"=",resta;
	Escribir "| ",numero1,"*",numero2,"=",multiplicacion;
	Escribir "| ",numero1,"/",numero2,"=",division;
FinAlgoritmo
